# ===========================================
# Airdrop Hunter - Environment Variables
# Copy this file to .env and fill the values
# NEVER commit .env to git
# ===========================================

# Database (use Neon or Supabase free Postgres)
DATABASE_URL=postgresql://user:password@host:5432/airdrop_hunter

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional API Keys (free tiers)
ETHERSCAN_API_KEY=your_etherscan_key   # https://etherscan.io/apis
GOPLUS_API_KEY=                        # optional, free without key for basic

# Scoring threshold for Telegram alerts (0-100)
ALERT_SCORE_THRESHOLD=60

# Scan interval in minutes
SCAN_INTERVAL_MINUTES=30

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
